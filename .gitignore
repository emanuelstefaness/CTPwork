# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (SQLite dev) and uploaded files
/prisma/dev.db
/prisma/dev.db-journal
/storage/uploads/*
!/storage/uploads/.gitkeep
# e-mails gravados em disco quando não há SMTP (contêm links de redefinição de senha)
/storage/emails/

# testes automatizados: banco, arquivos e relatórios gerados a cada execução
/storage-teste/
/prisma/teste.db*
/testes/relatorio/
/testes/resultados/
/testes/ultima-execucao.txt
/.playwright-mcp/

# material de referência (wireframes do design original, não faz parte do app)
/reference-screens
