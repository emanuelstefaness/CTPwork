# Copie para .env e preencha. O .env de verdade nunca vai para o git.

# Banco (SQLite em desenvolvimento; em produção, PostgreSQL — ver README)
DATABASE_URL="file:./dev.db"

# Assinatura do cookie de sessão. Gere um valor próprio: npx auth secret
AUTH_SECRET=""

# Obrigatória em servidor próprio (fora da Vercel), senão ninguém consegue entrar (UntrustedHost)
AUTH_TRUST_HOST=true

# Endereço público do sistema, usado nos links dos e-mails
APP_URL="http://localhost:4100"

# E-mail. Sem SMTP_HOST nada é enviado: os e-mails ficam em storage/emails para conferência.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CTP Work <nao-responda@ctp.org.br>"

# Mostra as contas de demonstração na tela de login em produção (em desenvolvimento aparecem sempre)
MOSTRAR_CONTAS_DEMO=false
